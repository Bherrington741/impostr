# --- Backend selection ---
# "local"     = BroadcastChannel + localStorage. Test multiplayer across browser tabs on one
#               machine with ZERO configuration (each tab = one player).
# "server"    = server-authoritative Next.js API routes, rooms in server memory.
#               NO database. Perfect for CloudPanel/VPS deploys; rooms are lost on
#               restart and everything must run in one process (PM2 fork mode).
# "supabase"  = server-authoritative Next.js API routes + Supabase Postgres/Realtime.
NEXT_PUBLIC_BACKEND=local

# --- Supabase (only needed when NEXT_PUBLIC_BACKEND=supabase) ---
# Server (service role is used ONLY by API routes, never shipped to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser (anon key, used only to subscribe to Realtime updates)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
